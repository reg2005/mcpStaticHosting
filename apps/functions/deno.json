{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run --unstable-worker-options --allow-net --allow-read --allow-write --allow-env main.ts",
    "start": "deno run --unstable-worker-options --allow-net --allow-read --allow-write --allow-env main.ts",
    "check": "deno check main.ts worker.ts"
  },
  "lint": {
    "rules": { "exclude": ["no-explicit-any"] }
  }
}
