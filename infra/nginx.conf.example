# Host-installed nginx. Replace domains and certificate paths before enabling.
server {
    listen 443 ssl;
    server_name panel.example.com;
    ssl_certificate /etc/ssl/panel/fullchain.pem;
    ssl_certificate_key /etc/ssl/panel/privkey.pem;
    client_max_body_size 10m;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
server {
    listen 443 ssl;
    server_name mcp.example.com;
    ssl_certificate /etc/ssl/mcp/fullchain.pem;
    ssl_certificate_key /etc/ssl/mcp/privkey.pem;
    client_max_body_size 10m;
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
server {
    listen 443 ssl;
    # Certificate must include both wildcard levels.
    server_name *.sites.example.net *.preview.sites.example.net;
    ssl_certificate /etc/ssl/sites/fullchain.pem;
    ssl_certificate_key /etc/ssl/sites/privkey.pem;
    client_max_body_size 10m;
    location ^~ /_internal/ { return 404; }
    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
