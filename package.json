{
  "name": "mcp-static-hosting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.6.7",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @mcphosting/db generate",
    "db:migrate": "pnpm --filter @mcphosting/db migrate",
    "db:push": "pnpm --filter @mcphosting/db push",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "@types/node": "^26.5.0",
    "@biomejs/biome": "2.4.6"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "postcss": "^8.5.23"
    }
  }
}
