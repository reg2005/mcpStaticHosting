# sh scripts/setup.sh --production creates .env.production with unique secrets.
COMPOSE_PROJECT_NAME=mcp-static-hosting-production
IMAGE_TAG=0.2.0
# Dashboard: https://MAIN_DOMAIN, MCP: https://MAIN_DOMAIN/mcp
# Create A records for MAIN_DOMAIN and *.MAIN_DOMAIN pointing to this server.
MAIN_DOMAIN=
ACME_EMAIL=
DNS_PROVIDER=cloudflare
DNS_CREDENTIALS_PATH=./secrets/dns.env
# Leave blank to detect the public IPv4 automatically. Set explicitly behind NAT.
PUBLIC_IPV4=
# Optional reachable IPv6. Remove AAAA records if this is blank.
PUBLIC_IPV6=
# Comma-separated IPv4/IPv6 CIDRs or IPs. Empty = management open to every IP.
MANAGEMENT_ALLOWED_CIDRS=
DNS_RESOLVERS=1.1.1.1,8.8.8.8
ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory
POSTGRES_PASSWORD=
APP_SECRET=
# Temporarily enable to create your first account. CIDR restrictions still apply.
SIGNUPS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=MCP Static Hosting <noreply@example.com>
MCP_RATE_LIMIT_PER_MIN=600
FUNCTIONS_ENABLED=false
FUNCTION_TIMEOUT_MS=10000
