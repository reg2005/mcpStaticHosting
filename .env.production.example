# sh scripts/setup.sh --production creates .env.production with unique secrets.
COMPOSE_PROJECT_NAME=mcp-static-hosting-production
IMAGE_TAG=0.1.0
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
MCP_PORT=3001
ROUTER_PORT=3002
# Replace all three with your own domains before starting.
AUTH_BASE_URL=
MCP_PUBLIC_URL=
PUBLIC_BASE_DOMAIN=
POSTGRES_PASSWORD=
APP_SECRET=
# Temporarily enable to create your first account behind the configured TLS proxy.
SIGNUPS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=MCP Static Hosting <noreply@example.com>
MCP_RATE_LIMIT_PER_MIN=600
FUNCTIONS_ENABLED=false
FUNCTION_TIMEOUT_MS=10000
