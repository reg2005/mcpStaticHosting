# syntax=docker/dockerfile:1
ARG APP_IMAGE=reg2005/mcp-static-hosting:0.3.0
FROM goacme/lego:v5.4.1@sha256:ac04a7aaac0270ca2c32f1e79b157087d763e78c4473551c6e093070614536e2 AS lego
FROM ${APP_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends nginx-light util-linux \
    && rm -rf /var/lib/apt/lists/* && mkdir -p /edge && chown node:node /edge
COPY --from=lego /lego /usr/local/bin/lego
COPY --chown=node:node apps/edge/src /app/apps/edge/src
USER node
LABEL org.opencontainers.image.title="MCP Static Hosting Edge" \
      org.opencontainers.image.description="Nginx with automatic wildcard DNS-01 and custom-domain HTTP-01 TLS"
EXPOSE 8080 8443
ENTRYPOINT ["flock", "-n", "/edge/worker.lock"]
CMD ["pnpm", "--filter", "@mcphosting/edge", "start"]
